<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.kriolos.efatura</groupId>
        <artifactId>kriolos-efatura</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>kriolos-efatura-datamodel</artifactId>
    <name>Kriolos :: eFatura :: Datamodel</name>
    <packaging>jar</packaging>
    
    <profiles>
        <profile>
            <id>efcv-jakarta-quarkus</id>
            <activation>
                <activeByDefault>true</activeByDefault>
                <property>
                    <name>framework</name>
                    <value>quarkus</value>
                </property>
            </activation> 
            <properties>
                <cxf-xjc-plugin.version>4.0.1</cxf-xjc-plugin.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.cxf</groupId>
                        <artifactId>cxf-xjc-plugin</artifactId>
                        <version>${cxf-xjc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>generate-jaxb-codes</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>xsdtojava</goal>
                                </goals>
                                <configuration>
                                    <!-- Define explicitamente a raiz da geração de código.
                                      O Maven irá concatenar esta raiz com o <packagename> indicado abaixo.
                                    -->
                                    <sourceRoot>${project.build.directory}/generated-sources/efatura</sourceRoot>
                                    <xsdOptions>
                                        <xsdOption>
                                            <extension>false</extension>
                                            <xsd>${project.basedir}/src/main/resources/schemas/efatura1/EnvelopedSignature.xsd</xsd>
                                            <packagename>io.github.kriolos.efatura.datamodel.fecv.generated</packagename>
                                        </xsdOption>
                                        <xsdOption>
                                            <extension>false</extension>
                                            <xsd>${project.basedir}/src/main/resources/schemas/saftcv1/saftcv1.01_01.xsd</xsd>
                                            <packagename>io.github.kriolos.efatura.datamodel.saftcv1.generated</packagename>
                                        </xsdOption>
                                    </xsdOptions>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>jakarta.xml.bind</groupId>
                                <artifactId>jakarta.xml.bind-api</artifactId>
                                <version>4.0.0</version>
                            </dependency>
                            <dependency>
                                <groupId>com.sun.xml.bind</groupId>
                                <artifactId>jaxb-impl</artifactId>
                                <version>4.0.2</version>
                            </dependency>
                            <dependency>
                                <groupId>jakarta.annotation</groupId>
                                <artifactId>jakarta.annotation-api</artifactId>
                                <version>2.1.1</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
            <dependencies>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-jaxb</artifactId>
                </dependency>
            </dependencies>
        </profile>


        <profile>
            
            <!-- javax for old java -->
            <id>efcv-javax</id>
            <activation>
                <property>
                    <name>efcv</name>
                </property>
            </activation>
            <properties>
                <!-- Version 3.x is last version with support for javax. -->
                <cxf.version>3.3.4</cxf.version>
                <cxf-xjc-plugin.version>3.2.1</cxf-xjc-plugin.version>
                <javax.activation.version>1.2.0</javax.activation.version>
                <jaxb.api.version>2.3.1</jaxb.api.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.cxf</groupId>
                        <artifactId>cxf-xjc-plugin</artifactId>
                        <version>${cxf-xjc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>generate-jaxb-codes</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>xsdtojava</goal>
                                </goals>
                                <configuration>
                                    <sourceRoot>${project.build.directory}/generated-sources/efatura</sourceRoot>
                                    <xsdOptions>
                                        <xsdOption>
                                            <extension>false</extension>
                                            <!--
                                            <catalog>${project.basedir}/src/main/resources/schemas/efcv-catalog.xml</catalog>
                                            -->
                                            <xsd>${project.basedir}/src/main/resources/schemas/efatura1/EnvelopedSignature.xsd</xsd>
                                            <packagename>io.github.kriolos.efatura.datamodel.fecv.generated</packagename>
                                        </xsdOption>
                                        <xsdOption>
                                            <extension>false</extension>
                                            <xsd>${project.basedir}/src/main/resources/schemas/saftcv1/saftcv1.01_01.xsd</xsd>
                                            <packagename>io.github.kriolos.efatura.datamodel.saftcv1.generated</packagename>
                                        </xsdOption>
                                    </xsdOptions>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
                            <dependency>
                                <groupId>com.sun.activation</groupId>
                                <artifactId>javax.activation</artifactId>
                                <version>${javax.activation.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>javax.xml.bind</groupId>
                                <artifactId>jaxb-api</artifactId>
                                <version>${jaxb.api.version}</version>
                            </dependency>
                            <!--- Required by XJC, JXC and Runtime modules: version 2 last for javax -->
                            <dependency>
                                <groupId>com.sun.xml.bind</groupId>
                                <artifactId>jaxb-core</artifactId>
                                <version>2.3.0.1</version>
                            </dependency>
                            <dependency>
                                <groupId>com.sun.xml.bind</groupId>
                                <artifactId>jaxb-impl</artifactId>
                                <version>${jaxb.api.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>javax.annotation</groupId>
                                <artifactId>javax.annotation-api</artifactId>
                                <version>1.3.2</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
            
            <dependencies>
                <!-- Java 9+ javax dependencies start -->
                <dependency>
                    <groupId>com.sun.activation</groupId>
                    <artifactId>javax.activation</artifactId>
                    <version>${javax.activation.version}</version>
                </dependency>

                <dependency>
                    <groupId>javax.xml.bind</groupId>
                    <artifactId>jaxb-api</artifactId>
                    <version>${jaxb.api.version}</version>
                    <exclusions>
                        <exclusion>
                            <groupId>javax.activation</groupId>
                            <artifactId>javax.activation-api</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
                <dependency>
                    <groupId>com.sun.xml.bind</groupId>
                    <artifactId>jaxb-core</artifactId>
                    <version>2.3.0.1</version>
                </dependency>
                <dependency>
                    <groupId>com.sun.xml.bind</groupId>
                    <artifactId>jaxb-impl</artifactId>
                    <version>${jaxb.api.version}</version>
                </dependency>
            </dependencies>
        </profile>
        
        <profile>
            <!-- Jarkarta for Java8 -->
            <id>efcv-jakarta</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <!-- Apache CXF 4.x migrou completamente para o ecossistema Jakarta EE -->
                <cxf.version>4.0.3</cxf.version>
                <cxf-xjc-plugin.version>4.0.0</cxf-xjc-plugin.version>
                <jakarta.activation.version>2.1.3</jakarta.activation.version>
                <jakarta.xml.bind.version>4.0.2</jakarta.xml.bind.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.cxf</groupId>
                        <artifactId>cxf-xjc-plugin</artifactId>
                        <version>${cxf-xjc-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>generate-jaxb-codes</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>xsdtojava</goal>
                                </goals>
                                <configuration>
                                    <sourceRoot>${project.build.directory}/generated-sources/efatura</sourceRoot>
                                    <xsdOptions>
                                        <xsdOption>
                                            <extension>false</extension>
                                            <xsd>${project.basedir}/src/main/resources/schemas/efatura1/EnvelopedSignature.xsd</xsd>
                                            <packagename>io.github.kriolos.efatura.datamodel.fecv.generated</packagename>
                                        </xsdOption>
                                        <xsdOption>
                                            <extension>false</extension>
                                            <xsd>${project.basedir}/src/main/resources/schemas/saftcv1/saftcv1.01_01.xsd</xsd>
                                            <packagename>io.github.kriolos.efatura.datamodel.saftcv1.generated</packagename>
                                        </xsdOption>
                                    </xsdOptions>
                                </configuration>
                            </execution>
                        </executions>
                        <dependencies>
                            <!-- Extensão necessária para o XJC gerar classes compatíveis com Jakarta -->
                            <dependency>
                                <groupId>jakarta.activation</groupId>
                                <artifactId>jakarta.activation-api</artifactId>
                                <version>${jakarta.activation.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>jakarta.xml.bind</groupId>
                                <artifactId>jakarta.xml.bind-api</artifactId>
                                <version>${jakarta.xml.bind.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>com.sun.xml.bind</groupId>
                                <artifactId>jaxb-impl</artifactId>
                                <version>${jakarta.xml.bind.version}</version>
                            </dependency>
                            <dependency>
                                <groupId>jakarta.annotation</groupId>
                                <artifactId>jakarta.annotation-api</artifactId>
                                <version>2.1.1</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
    
            <dependencies>
                <!-- Dependências do Runtime Jakarta XML Binding (JAXB 4) -->
                <dependency>
                    <groupId>jakarta.activation</groupId>
                    <artifactId>jakarta.activation-api</artifactId>
                </dependency>
                <dependency>
                    <groupId>jakarta.xml.bind</groupId>
                    <artifactId>jakarta.xml.bind-api</artifactId>
                </dependency>
                <dependency>
                    <groupId>com.sun.xml.bind</groupId>
                    <artifactId>jaxb-impl</artifactId>
                    <version>${jakarta.xml.bind.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

    </profiles>
</project>